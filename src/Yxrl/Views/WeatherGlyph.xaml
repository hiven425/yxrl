<UserControl x:Class="Yxrl.Views.WeatherGlyph" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False">
  <UserControl.Resources>
    <RadialGradientBrush x:Key="SunGlass" GradientOrigin=".29,.23" Center=".48,.47" RadiusX=".66" RadiusY=".68">
      <GradientStop Color="#FFFFFDE5" Offset="0"/><GradientStop Color="#F9FFD075" Offset=".51"/>
      <GradientStop Color="#DEEE8B2F" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="DawnGlass" GradientOrigin=".31,.24" RadiusX=".68" RadiusY=".72">
      <GradientStop Color="#FFFFFBD7" Offset="0"/><GradientStop Color="#F7FFC37F" Offset=".52"/>
      <GradientStop Color="#DDF49964" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="DuskGlass" GradientOrigin=".29,.21" RadiusX=".69" RadiusY=".7">
      <GradientStop Color="#FFFFE3AE" Offset="0"/><GradientStop Color="#F5FB9976" Offset=".58"/>
      <GradientStop Color="#DAAD628C" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CloudGlass" StartPoint="0,0" EndPoint=".8,1">
      <GradientStop Color="#F8FCFEFF" Offset="0"/><GradientStop Color="#EADEEFF9" Offset=".42"/>
      <GradientStop Color="#CE79B6D2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IceGlass" StartPoint="0,0" EndPoint=".67,1">
      <GradientStop Color="#F8F3FFFF" Offset="0"/><GradientStop Color="#EAA3E5FF" Offset=".49"/>
      <GradientStop Color="#E34085D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HorizonGlass">
      <GradientStop Color="#0099A6DC" Offset="0"/><GradientStop Color="#DDAC86AB" Offset=".5"/>
      <GradientStop Color="#0099A6DC" Offset="1"/>
    </LinearGradientBrush>
    <Geometry x:Key="WaterDrop">M2,0 C1.3,1.7 0,3.7 0,5.6 C0,8.2 4,8.2 4,5.6 C4,3.7 2.7,1.7 2,0 Z</Geometry>
  </UserControl.Resources>
  <Viewbox Stretch="Uniform">
    <Canvas Width="64" Height="52" ClipToBounds="True">
      <Canvas x:Name="Solar" Visibility="Collapsed">
        <Canvas.RenderTransform><TranslateTransform x:Name="SunShift"/></Canvas.RenderTransform>
        <Path Data="M32,3 V8 M32,40 V45 M11,24 H16 M48,24 H53 M17,9 L21,13 M43,35 L47,39 M17,39 L21,35 M43,13 L47,9"
              Stroke="#DDE7A03D" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
          <Path.RenderTransform><RotateTransform x:Name="RaysRotation" CenterX="32" CenterY="24"/></Path.RenderTransform>
        </Path>
        <Ellipse Canvas.Left="19" Canvas.Top="11" Width="26" Height="26" Fill="{StaticResource SunGlass}" Stroke="#BDA16D32"/>
        <Path Data="M23,21 Q26,15 33,15" Stroke="#EEFFFBDB" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="Lunar" Visibility="Collapsed">
        <Canvas.RenderTransform><TranslateTransform x:Name="MoonShift"/></Canvas.RenderTransform>
        <Path Data="M38,9 C25,7 15,16 16,27 C17,38 30,44 41,37 C29,36 23,22 38,9 Z"
              Fill="{StaticResource IceGlass}" Stroke="#C273A2D8" StrokeThickness="1"/>
        <Path x:Name="Stars" Data="M46,7 L47.5,10.5 L51,12 L47.5,13.5 L46,17 L44.5,13.5 L41,12 L44.5,10.5 Z M53,20 L54,22.5 L56.5,23.5 L54,24.5 L53,27 L52,24.5 L49.5,23.5 L52,22.5 Z"
              Fill="#EE88B8EC" Stroke="#AAA8DAFF" StrokeThickness=".5"/>
      </Canvas>
      <Canvas x:Name="Twilight" Visibility="Collapsed">
        <Canvas Clip="M5,0 H59 V33 H5 Z">
          <Ellipse x:Name="HorizonSun" Canvas.Left="18" Canvas.Top="11" Width="28" Height="28"
                   Fill="{StaticResource DawnGlass}" Stroke="#BDB17D5E">
            <Ellipse.RenderTransform><TranslateTransform x:Name="HorizonSunMotion"/></Ellipse.RenderTransform>
          </Ellipse>
        </Canvas>
        <Rectangle Canvas.Left="5" Canvas.Top="33" Width="54" Height="2.2" RadiusX="1" RadiusY="1" Fill="{StaticResource HorizonGlass}"/>
        <Rectangle Canvas.Left="12" Canvas.Top="39" Width="40" Height="1.6" RadiusX="1" RadiusY="1" Fill="{StaticResource HorizonGlass}"/>
        <Rectangle Canvas.Left="21" Canvas.Top="44" Width="22" Height="1.4" RadiusX="1" RadiusY="1" Fill="{StaticResource HorizonGlass}" Opacity=".67"/>
      </Canvas>
      <Canvas x:Name="Clouds" Visibility="Collapsed">
        <Canvas.RenderTransform><TranslateTransform x:Name="CloudMotion"/></Canvas.RenderTransform>
        <Path Data="M31,30 C22,30 20,23 24,18 C26,15 29,14 33,15 C36,7 47,8 51,16 C59,15 63,20 61,25 C60,28 57,30 54,30 Z"
              Fill="{StaticResource CloudGlass}" Stroke="#AC759DB1" StrokeThickness="1" Opacity=".75"/>
        <Path Data="M16,36 C7,36 5,28 9,24 C11,21 15,20 19,21 C22,14 32,13 37,19 C43,17 49,21 49,25 C57,26 57,36 49,36 Z"
              Fill="{StaticResource CloudGlass}" Stroke="#C46C9CB9" StrokeThickness="1"/>
        <Path Data="M13,27 Q16,23 22,24 Q26,18 32,19" Stroke="#F7FFFFFF" StrokeThickness="1.35"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="Rain" Visibility="Collapsed">
        <Path Canvas.Left="18" Canvas.Top="38" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#AC4282BA" StrokeThickness=".55">
          <Path.RenderTransform><TranslateTransform x:Name="FirstDropMotion"/></Path.RenderTransform>
        </Path>
        <Path Canvas.Left="30" Canvas.Top="41" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#AC4282BA" StrokeThickness=".55">
          <Path.RenderTransform><TranslateTransform x:Name="SecondDropMotion"/></Path.RenderTransform>
        </Path>
        <Path Canvas.Left="44" Canvas.Top="36" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#AC4282BA" StrokeThickness=".55">
          <Path.RenderTransform><TranslateTransform x:Name="ThirdDropMotion"/></Path.RenderTransform>
        </Path>
      </Canvas>
      <Canvas x:Name="Flakes" Visibility="Collapsed">
        <Canvas.RenderTransform><TranslateTransform x:Name="SnowMotion"/></Canvas.RenderTransform>
        <Path Data="M17,40 H25 M21,36 V44 M18,37 L24,43 M18,43 L24,37 M29,46 H37 M33,42 V50 M30,43 L36,49 M30,49 L36,43 M42,39 H50 M46,35 V43 M43,36 L49,42 M43,42 L49,36"
              Stroke="{StaticResource IceGlass}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Path x:Name="Bolt" Data="M36,26 L27,39 H34 L30,51 L44,34 H37 L41,26 Z"
            Fill="{StaticResource SunGlass}" Stroke="#CEAB782F" StrokeThickness=".8" Visibility="Collapsed"/>
      <Path x:Name="Fog" Data="M10,35 H44 M16,41 H57 M7,47 H34"
            Stroke="#D080A7C3" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed">
        <Path.RenderTransform><TranslateTransform x:Name="FogMotion"/></Path.RenderTransform>
      </Path>
      <Path x:Name="Wind" Data="M8,19 H38 Q48,19 47,12 Q46,6 40,9 M11,27 H50 Q57,27 54,33 Q52,37 47,35 M15,36 H34 Q40,36 40,41"
            Stroke="{StaticResource IceGlass}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed">
        <Path.RenderTransform><TranslateTransform x:Name="WindMotion"/></Path.RenderTransform>
      </Path>
      <Canvas x:Name="Unknown">
        <Ellipse Canvas.Left="20" Canvas.Top="12" Width="24" Height="24" Fill="#366DA1C3" Stroke="#9B71A4C5"/>
        <Path Data="M27,24 H37" Stroke="#CB6498BE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
