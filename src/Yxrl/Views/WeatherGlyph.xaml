<UserControl x:Class="Yxrl.Views.WeatherGlyph" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False">
  <UserControl.Resources>
    <RadialGradientBrush x:Key="SunHaloGlass" Center=".5,.5" RadiusX=".5" RadiusY=".5">
      <GradientStop Color="#66FFE082" Offset="0"/>
      <GradientStop Color="#22FFB74D" Offset=".62"/>
      <GradientStop Color="#00FFB74D" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SunGlass" GradientOrigin=".28,.22" Center=".48,.46" RadiusX=".68" RadiusY=".68">
      <GradientStop Color="#FFFFFBE0" Offset="0"/>
      <GradientStop Color="#FAFFD166" Offset=".52"/>
      <GradientStop Color="#E6EF8324" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="DawnGlass" GradientOrigin=".3,.22" RadiusX=".7" RadiusY=".7">
      <GradientStop Color="#FFFFF7CF" Offset="0"/>
      <GradientStop Color="#F8FFB770" Offset=".52"/>
      <GradientStop Color="#E3F06E5B" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="DuskGlass" GradientOrigin=".28,.22" RadiusX=".7" RadiusY=".7">
      <GradientStop Color="#FFFFE2A8" Offset="0"/>
      <GradientStop Color="#F5F78E69" Offset=".55"/>
      <GradientStop Color="#E0A54B87" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CloudBackGlass" StartPoint="0,0" EndPoint=".85,1">
      <GradientStop Color="#E6F5FAFF" Offset="0"/>
      <GradientStop Color="#D0CEE5F5" Offset=".5"/>
      <GradientStop Color="#B882B3D1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloudFrontGlass" StartPoint="0,0" EndPoint=".75,1">
      <GradientStop Color="#FAFFFFFF" Offset="0"/>
      <GradientStop Color="#ECE2F2FC" Offset=".46"/>
      <GradientStop Color="#D68BC3DF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StormCloudGlass" StartPoint="0,0" EndPoint=".8,1">
      <GradientStop Color="#F0EBF4FC" Offset="0"/>
      <GradientStop Color="#E4BBD4E8" Offset=".5"/>
      <GradientStop Color="#D86998BA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IceGlass" StartPoint="0,0" EndPoint=".65,1">
      <GradientStop Color="#FAF4FFFF" Offset="0"/>
      <GradientStop Color="#EE8FE0FF" Offset=".48"/>
      <GradientStop Color="#E53580D1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoonGlass" StartPoint=".1,0" EndPoint=".9,1">
      <GradientStop Color="#FAEEF7FF" Offset="0"/>
      <GradientStop Color="#EEAED8FF" Offset=".52"/>
      <GradientStop Color="#E06299D6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HorizonGlass" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00A698D8" Offset="0"/>
      <GradientStop Color="#EECC8AA8" Offset=".5"/>
      <GradientStop Color="#00A698D8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MistGlass" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#44A8CBE0" Offset="0"/>
      <GradientStop Color="#E8E8F4FC" Offset=".5"/>
      <GradientStop Color="#447BAAC8" Offset="1"/>
    </LinearGradientBrush>
    <Geometry x:Key="WaterDrop">M2.1,0 C1.3,1.9 0,4.1 0,6.1 C0,8.7 4.2,8.7 4.2,6.1 C4.2,4.1 2.9,1.9 2.1,0 Z</Geometry>
    <Geometry x:Key="SnowCrystal">M0,-3.5 V3.5 M-3.5,0 H3.5 M-2.4,-2.4 L2.4,2.4 M-2.4,2.4 L2.4,-2.4</Geometry>
  </UserControl.Resources>

  <Border x:Name="GlassPlate" CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Border x:Name="GlassSheen" CornerRadius="9" IsHitTestVisible="False" Opacity="0.55">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,0.85">
            <GradientStop Color="#66FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="0.42"/>
            <GradientStop Color="#00FFFFFF" Offset="0.72"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Viewbox Stretch="Uniform" Margin="2">
        <Canvas Width="64" Height="54" ClipToBounds="True">
          <Canvas x:Name="Solar" Visibility="Collapsed">
            <Canvas.RenderTransform><TranslateTransform x:Name="SunShift"/></Canvas.RenderTransform>
            <Ellipse x:Name="SunHalo" Canvas.Left="10" Canvas.Top="4" Width="44" Height="44" Fill="{StaticResource SunHaloGlass}">
              <Ellipse.RenderTransform><ScaleTransform x:Name="SunHaloScale" CenterX="22" CenterY="22"/></Ellipse.RenderTransform>
            </Ellipse>
            <Path Data="M32,4 V9.5 M32,42.5 V48 M10,26 H15.5 M48.5,26 H54 M16.4,10.4 L20.3,14.3 M43.7,37.7 L47.6,41.6 M16.4,41.6 L20.3,37.7 M43.7,14.3 L47.6,10.4"
                  Stroke="#E8EB9C36" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><RotateTransform x:Name="RaysRotation" CenterX="32" CenterY="26"/></Path.RenderTransform>
            </Path>
            <Ellipse Canvas.Left="19" Canvas.Top="13" Width="26" Height="26" Fill="{StaticResource SunGlass}" Stroke="#C4A66B2C" StrokeThickness="1"/>
            <Path Data="M23.5,22.5 Q26.5,16.8 33.5,16.8" Stroke="#F4FFFCE0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>

          <Canvas x:Name="Lunar" Visibility="Collapsed">
            <Canvas.RenderTransform><TranslateTransform x:Name="MoonShift"/></Canvas.RenderTransform>
            <Path x:Name="MoonBody" Data="M37.5,10 C24.5,8.5 14.5,17.5 15.8,28.5 C17.1,39.5 30,45.2 40.8,38.2 C29,37 22.8,23 37.5,10 Z"
                  Fill="{StaticResource MoonGlass}" Stroke="#C86D9ED8" StrokeThickness="1">
              <Path.RenderTransform><TranslateTransform x:Name="MoonFloat"/></Path.RenderTransform>
            </Path>
            <Path x:Name="StarMajor" Data="M45.5,8 L47.1,11.8 L51,13.5 L47.1,15.2 L45.5,19 L43.9,15.2 L40,13.5 L43.9,11.8 Z"
                  Fill="#F29ACEFF" Stroke="#B8D9F0FF" StrokeThickness="0.5"/>
            <Path x:Name="StarMinor" Data="M53.5,21 L54.6,23.6 L57.2,24.7 L54.6,25.8 L53.5,28.4 L52.4,25.8 L49.8,24.7 L52.4,23.6 Z"
                  Fill="#E889BFEF" Stroke="#AAD0ECFF" StrokeThickness="0.4"/>
          </Canvas>

          <Canvas x:Name="Twilight" Visibility="Collapsed">
            <Ellipse x:Name="TwilightGlow" Canvas.Left="10" Canvas.Top="14" Width="44" Height="30" Fill="{StaticResource SunHaloGlass}" Opacity="0.7"/>
            <Canvas Clip="M5,2 H59 V35 H5 Z">
              <Ellipse x:Name="HorizonSun" Canvas.Left="18" Canvas.Top="13" Width="28" Height="28"
                       Fill="{StaticResource DawnGlass}" Stroke="#C6B17258" StrokeThickness="1">
                <Ellipse.RenderTransform><TranslateTransform x:Name="HorizonSunMotion"/></Ellipse.RenderTransform>
              </Ellipse>
            </Canvas>
            <Rectangle x:Name="HorizonBar1" Canvas.Left="6" Canvas.Top="35" Width="52" Height="2.4" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource HorizonGlass}"/>
            <Rectangle x:Name="HorizonBar2" Canvas.Left="13" Canvas.Top="40.5" Width="38" Height="1.8" RadiusX="0.9" RadiusY="0.9" Fill="{StaticResource HorizonGlass}" Opacity="0.82"/>
            <Rectangle Canvas.Left="21" Canvas.Top="45.5" Width="22" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="{StaticResource HorizonGlass}" Opacity="0.55"/>
          </Canvas>

          <Canvas x:Name="Clouds" Visibility="Collapsed">
            <Canvas.RenderTransform><TranslateTransform x:Name="CloudMotion"/></Canvas.RenderTransform>
            <Path Data="M31,30 C22,30 20,23 24,18 C26,15 29,14 33,15 C36,7 47,8 51,16 C59,15 63,20 61,25 C60,28 57,30 54,30 Z"
                  Fill="{StaticResource CloudBackGlass}" Stroke="#B4769EB4" StrokeThickness="1" Opacity="0.82">
              <Path.RenderTransform><TranslateTransform x:Name="BackCloudMotion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="FrontCloud" Data="M16,36 C7,36 5,28 9,24 C11,21 15,20 19,21 C22,14 32,13 37,19 C43,17 49,21 49,25 C57,26 57,36 49,36 Z"
                  Fill="{StaticResource CloudFrontGlass}" Stroke="#D06B9DBB" StrokeThickness="1.05"/>
            <Path Data="M12.5,27 Q16,22.8 22.2,23.8 Q26.5,17.8 32.8,19" Stroke="#FCFFFFFF" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>

          <Canvas x:Name="Rain" Visibility="Collapsed">
            <Path x:Name="Drop1" Canvas.Left="15" Canvas.Top="36" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#BD3D7EB8" StrokeThickness="0.6">
              <Path.RenderTransform><TranslateTransform x:Name="Drop1Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Drop2" Canvas.Left="26" Canvas.Top="38" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#BD3D7EB8" StrokeThickness="0.6">
              <Path.RenderTransform><TranslateTransform x:Name="Drop2Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Drop3" Canvas.Left="37" Canvas.Top="35" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#BD3D7EB8" StrokeThickness="0.6">
              <Path.RenderTransform><TranslateTransform x:Name="Drop3Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Drop4" Canvas.Left="46" Canvas.Top="38" Data="{StaticResource WaterDrop}" Fill="{StaticResource IceGlass}" Stroke="#BD3D7EB8" StrokeThickness="0.6">
              <Path.RenderTransform><TranslateTransform x:Name="Drop4Motion"/></Path.RenderTransform>
            </Path>
          </Canvas>

          <Canvas x:Name="Flakes" Visibility="Collapsed">
            <Path x:Name="Flake1" Canvas.Left="18" Canvas.Top="40" Data="{StaticResource SnowCrystal}" Stroke="{StaticResource IceGlass}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Flake1Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Flake2" Canvas.Left="31" Canvas.Top="42" Data="{StaticResource SnowCrystal}" Stroke="{StaticResource IceGlass}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Flake2Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Flake3" Canvas.Left="44" Canvas.Top="39" Data="{StaticResource SnowCrystal}" Stroke="{StaticResource IceGlass}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Flake3Motion"/></Path.RenderTransform>
            </Path>
          </Canvas>

          <Path x:Name="Bolt" Data="M35.5,26 L26.5,39.5 H33.5 L29.5,52 L44.5,34.5 H37 L41,26 Z"
                Fill="{StaticResource SunGlass}" Stroke="#D8AA7428" StrokeThickness="0.85" Visibility="Collapsed"/>

          <Canvas x:Name="Fog" Visibility="Collapsed">
            <Path x:Name="FogBand1" Data="M10,36 H44" Stroke="{StaticResource MistGlass}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Fog1Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="FogBand2" Data="M17,42 H55" Stroke="{StaticResource MistGlass}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Fog2Motion"/></Path.RenderTransform>
            </Path>
            <Path x:Name="FogBand3" Data="M8,48 H37" Stroke="{StaticResource MistGlass}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Fog3Motion"/></Path.RenderTransform>
            </Path>
          </Canvas>

          <Canvas x:Name="Wind" Visibility="Collapsed">
            <Path Data="M8,20 H38 Q48,20 47,12.5 Q46,6.5 40,9.5" Stroke="{StaticResource IceGlass}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Wind1Motion"/></Path.RenderTransform>
            </Path>
            <Path Data="M11,28.5 H50 Q57,28.5 54,34.5 Q52,38.5 47,36.5" Stroke="{StaticResource CloudFrontGlass}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Wind2Motion"/></Path.RenderTransform>
            </Path>
            <Path Data="M15,37.5 H35 Q41,37.5 41,42.5" Stroke="{StaticResource IceGlass}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.RenderTransform><TranslateTransform x:Name="Wind3Motion"/></Path.RenderTransform>
            </Path>
          </Canvas>

          <Canvas x:Name="Unknown">
            <Path Data="M16,36 C8,36 6,29 10,25 C12,22 15,21 19,22 C22,15 32,14 37,20 C43,18 49,22 49,26 C56,27 56,36 48,36 Z"
                  Fill="{StaticResource CloudFrontGlass}" Stroke="#B46D9BB8" StrokeThickness="1" Opacity="0.72"/>
            <Path Data="M13,28 Q16.5,24 22.5,24.8 Q26.5,19 32.5,20" Stroke="#CCFFFFFF" StrokeThickness="1.3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
        </Canvas>
      </Viewbox>
    </Grid>
  </Border>
</UserControl>
