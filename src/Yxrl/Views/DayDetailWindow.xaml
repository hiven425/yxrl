<Window x:Class="Yxrl.Views.DayDetailWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YXRL 日详情" AutomationProperties.AutomationId="YxrlDayDetail"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="OnKey">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12">
    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Width="294">
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="×" FontSize="20" Width="30" Height="30" Padding="0" Click="CloseClick"
                  AutomationProperties.Name="关闭日详情" ToolTip="关闭日详情"/>
          <TextBlock Text="日详情" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="DayHeading" FontSize="31" FontWeight="SemiBold"/>
        <TextBlock x:Name="DayWeek" Style="{StaticResource Subtle}"/>
        <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="13" Margin="0,14,0,12">
          <StackPanel>
            <TextBlock x:Name="DayLunarFull" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="DayGanzhi" Margin="0,4,0,0" Style="{StaticResource Subtle}"/>
            <TextBlock x:Name="DayEvents" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <TextBlock Text="宜" FontWeight="Bold" Foreground="{DynamicResource Positive}"/>
        <TextBlock x:Name="DayYiFull" Margin="0,4,0,14" TextWrapping="Wrap"/>
        <TextBlock Text="忌" FontWeight="Bold" Foreground="{DynamicResource Weekend}"/>
        <TextBlock x:Name="DayJiFull" Margin="0,4" TextWrapping="Wrap"/>
      </StackPanel>
    </Viewbox>
  </Border>
</Window>
