<Window x:Class="Yxrl.Views.DayDetailWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YXRL 日详情" AutomationProperties.AutomationId="YxrlDayDetail" Width="344" Height="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="OnKey">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="RootBorder" Background="{DynamicResource SurfaceGlass}" BorderThickness="0">
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="17,11,13,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Click="CloseClick"
                  AutomationProperties.Name="关闭日详情" ToolTip="关闭日详情"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Content="&#xE8BB;"/>
          <TextBlock Text="当日详情" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="17,15,17,16">
          <DockPanel>
            <Border DockPanel.Dock="Left" Width="54" Height="58" CornerRadius="9" Background="{DynamicResource Paper}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
              <Border.Effect>
                <DropShadowEffect Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.12" Color="#0A233D"/>
              </Border.Effect>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="18"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource AccentGradient}" CornerRadius="8,8,0,0">
                  <TextBlock x:Name="TileMonth" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnSelected}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Border>
                <TextBlock x:Name="TileDay" Grid.Row="1" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="DayHeading" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
              <TextBlock x:Name="DayWeek" Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>
              <WrapPanel x:Name="DayTags" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource GroupCard}" Padding="14,12" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock x:Name="DayLunarFull" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="DayGanzhi" Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0"/>
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource WorkFill}" CornerRadius="4" Padding="5,2" VerticalAlignment="Top" Margin="0,1,9,0">
                  <TextBlock Text="宜" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Positive}"/>
                </Border>
                <TextBlock x:Name="DayYiFull" Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>

                <Border Grid.Row="2" Background="{DynamicResource RestFill}" CornerRadius="4" Padding="5,2" VerticalAlignment="Top" Margin="0,1,9,0">
                  <TextBlock Text="忌" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Weekend}"/>
                </Border>
                <TextBlock x:Name="DayJiFull" Grid.Row="2" Grid.Column="1" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
