<Window x:Class="Yxrl.Views.ReminderEditorWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建日期提醒" AutomationProperties.AutomationId="YxrlReminderEditor" Width="416" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource Surface}">
  <StackPanel Margin="18,15">
    <Border Style="{StaticResource GroupCard}">
      <StackPanel>
        <Label Content="标题" Target="{Binding ElementName=TitleField}" Padding="0,0,0,5"/>
        <TextBox x:Name="TitleField" AutomationProperties.Name="提醒标题" TextChanged="DraftChanged"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="事项日期" Target="{Binding ElementName=DateField}" Padding="0,0,0,5"/>
            <DatePicker x:Name="DateField" AutomationProperties.Name="事项日期"
                        SelectedDateChanged="DraftChanged" DateValidationError="DateInvalid"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="事项时间（24 小时制）" Target="{Binding ElementName=TimeField}" Padding="0,0,0,5"/>
            <TextBox x:Name="TimeField" AutomationProperties.Name="事项时间" MaxLength="5" TextChanged="DraftChanged" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </Grid>
        <Label Content="提前分钟数" Target="{Binding ElementName=LeadField}" Padding="0,12,0,5"/>
        <DockPanel LastChildFill="False">
          <ComboBox x:Name="LeadField" AutomationProperties.Name="提前分钟数" Width="114" IsEditable="True" IsTextSearchEnabled="False"
                    SelectionChanged="DraftChanged" TextBoxBase.TextChanged="DraftChanged"/>
          <TextBlock Text="可直接输入，0 为到点提醒" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="11,9" Margin="0,10,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Margin="0,1,9,1"/>
        <TextBlock DockPanel.Dock="Left" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="NextAlert" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"
               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    <DockPanel Margin="0,13,0,0" LastChildFill="False">
      <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource Danger}"
              Content="删除提醒" Visibility="Collapsed" Click="DeleteClick" DockPanel.Dock="Left"/>
      <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
              AutomationProperties.Name="保存提醒" IsDefault="True" Click="SaveClick" Content="保存提醒"/>
      <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True" DockPanel.Dock="Right" Margin="0,0,8,0"/>
    </DockPanel>
  </StackPanel>
</Window>
