<Window x:Class="Yxrl.Views.ReminderPopup" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YXRL 日期提醒" AutomationProperties.AutomationId="YxrlReminderPopup" Width="344" Height="166"
        WindowStyle="ToolWindow" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource Surface}">
  <DockPanel Margin="13,10">
    <Button DockPanel.Dock="Bottom" Content="知道了" Click="Dismiss" HorizontalAlignment="Right" Margin="0,7,0,0" Padding="12,4"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Notices">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Card}" CornerRadius="7" Padding="9,7" Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
