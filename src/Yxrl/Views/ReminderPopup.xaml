<Window x:Class="Yxrl.Views.ReminderPopup" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YXRL 日期提醒" AutomationProperties.AutomationId="YxrlReminderPopup" Width="344" Height="180"
        WindowStyle="ToolWindow" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource Surface}">
  <DockPanel Margin="14,12">
    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="知道了" Click="Dismiss"
            HorizontalAlignment="Right" Margin="0,10,0,0" MinHeight="29" Padding="18,4"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Notices">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="9" Padding="11,9" Margin="0,0,0,6">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Margin="0,1,9,1"/>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
