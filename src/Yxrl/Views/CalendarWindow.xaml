<Window x:Class="Yxrl.Views.CalendarWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Yxrl.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="YXRL 月历" AutomationProperties.AutomationId="YxrlFlyout"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True" SizeChanged="ScaleContent" KeyDown="OnKey">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="12" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="GlassCardButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource GlassFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="11"
                      Margin="-1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource GlassHover}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DayCell" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <Grid>
                  <Border x:Name="HoverOverlay" Background="{DynamicResource HoverFill}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                  <Border Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="9"
                      Margin="-1" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.22"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="RootBorder" Background="{DynamicResource SurfaceGlass}" BorderThickness="0" Padding="17,14,17,12">
      <Grid x:Name="CalendarSurface">
        <Grid.LayoutTransform><ScaleTransform x:Name="ContentScale"/></Grid.LayoutTransform>
        <Grid x:Name="MonthPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button x:Name="WeatherButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                      Style="{StaticResource GlassCardButton}" Click="WeatherClick" AutomationProperties.Name="城市与天气">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <local:WeatherGlyph x:Name="WeatherIcon" Width="46" Height="38" Margin="0,0,8,0"/>
                  <StackPanel VerticalAlignment="Center" MaxWidth="112">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                      <TextBlock x:Name="WeatherTemp" FontSize="20" FontWeight="SemiBold" LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                 Typography.NumeralAlignment="Tabular"/>
                      <TextBlock x:Name="WeatherCond" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="4,0,0,1"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="WeatherMeta" FontSize="10.5" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="WeatherSub" FontSize="10" Foreground="{DynamicResource Faint}"
                               TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LiveTime" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="44" FontWeight="SemiBold"
                           LineHeight="46" LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"><Run x:Name="TimePart"/><Run x:Name="SecondsPart" FontSize="24" FontWeight="Normal" Foreground="{DynamicResource Muted}"/></TextBlock>
                <TextBlock x:Name="TodayLine" Style="{StaticResource Subtle}" FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,11,0,9"/>
            <DockPanel Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="今天" Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource Accent}"
                        MinHeight="26" Padding="10,2" FontSize="12" Margin="0,0,4,0" Click="TodayClick"/>
                <Button x:Name="Previous" Style="{StaticResource IconButton}" Width="28" Height="28"
                        AutomationProperties.Name="上个月" ToolTip="上个月" Click="PreviousClick"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Content="&#xE76B;"/>
                <Button x:Name="Next" Style="{StaticResource IconButton}" Width="28" Height="28"
                        AutomationProperties.Name="下个月" ToolTip="下个月" Click="NextClick"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Content="&#xE76C;"/>
              </StackPanel>
              <TextBlock x:Name="MonthTitle" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"><Run x:Name="MonthYear" FontSize="19" FontWeight="SemiBold"/><Run Text=" 年 " FontSize="12.5" Foreground="{DynamicResource Muted}"/><Run x:Name="MonthNumber" FontSize="19" FontWeight="SemiBold"/><Run Text=" 月" FontSize="12.5" Foreground="{DynamicResource Muted}"/></TextBlock>
            </DockPanel>
          </StackPanel>

          <Grid x:Name="DaysGrid" Grid.Row="1" AutomationProperties.Name="月历日期" Margin="0,2,0,8"/>

          <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="11,8">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="DetailToggleButton" Click="DetailToggleClick" Padding="7,4" MinHeight="28"
                        Foreground="{DynamicResource Accent}" FontSize="12" ToolTip="展开或收起当日详情" Margin="0,0,2,0"/>
                <Button x:Name="CaptureEntry" AutomationProperties.Name="截图工具" ToolTip="截图工具" Width="30" Height="30"
                        Click="CaptureMenuClick" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE722;">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="开始截图" Tag="Start" Click="CaptureCommand"/>
                      <MenuItem Header="录制屏幕" Tag="Record" Click="CaptureCommand"/>
                      <MenuItem Header="恢复录屏" Click="RecoverRecording"/>
                      <MenuItem Header="钉住剪贴板内容" Tag="Clipboard" Click="CaptureCommand"/>
                      <MenuItem Header="恢复关闭的贴图" Tag="RestorePin" Click="CaptureCommand"/>
                      <MenuItem Header="粘贴文字翻译" Tag="Translate" Click="CaptureCommand"/>
                      <MenuItem Header="截图与翻译设置" Click="CaptureCommand"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <ToggleButton x:Name="PinButton" Width="30" Height="30" Margin="0,0,2,0"
                              AutomationProperties.AutomationId="CalendarPin" AutomationProperties.Name="固定月历"
                              Checked="PinChanged" Unchecked="PinChanged" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15">
                  <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                      <Setter Property="ToolTip" Value="钉住月历"/>
                      <Setter Property="Content" Value="&#xE718;"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hot}"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                              </Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                          <Setter Property="Content" Value="&#xE842;"/>
                          <Setter Property="ToolTip" Value="取消固定月历"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="30" Height="30" Click="SettingsClick"
                        AutomationProperties.Name="时钟设置" ToolTip="打开设置" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Content="&#xE713;"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="13.5" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="DetailLunar" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <WrapPanel x:Name="DetailTags" Margin="0,4,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Data="M 0,6 L 6,0 M 0,10 L 10,0"
          Stroke="{DynamicResource Muted}" StrokeThickness="1" Opacity="0.32" IsHitTestVisible="False"/>
    <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Data="M 0,10 L 10,0 M 4,10 L 10,4"
          Stroke="{DynamicResource Muted}" StrokeThickness="1" Opacity="0.32" IsHitTestVisible="False"/>
  </Grid>
</Window>
